{
  "unitId": "P13",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "P13-PRD01",
        "heading": "Snell's Law & the Invariants of Refraction",
        "proseLatex": "$n = \\frac{c}{v} = \\frac{\\lambda_0}{\\lambda}$; crossing media keeps FREQUENCY (and photon energy $h\\nu$) strictly constant while speed and wavelength scale by $1/n$. Snell: $n_1\\sin\\theta_1 = n_2\\sin\\theta_2$ — rays bend toward the normal entering a denser medium. Micro-check: $n = 1.5$: $v = 2\\times10^8\\,\\text{m/s}$, $\\lambda = \\frac{2}{3}\\lambda_0$."
      },
      {
        "prdId": "P13-PRD02",
        "heading": "Apparent Depth & Normal Shift",
        "proseLatex": "Near-normal viewing: $d_{\\text{app}} = \\frac{d}{n}$; normal shift $\\Delta d = d\\left(1 - \\frac{1}{n}\\right)$, ADDITIVE across stacked slabs. Micro-check: water $n = 4/3$, depth $12\\,\\text{m}$: apparent $9\\,\\text{m}$, shift $3\\,\\text{m}$."
      },
      {
        "prdId": "P13-PRD03",
        "heading": "Total Internal Reflection: the Denser-to-Rarer Gate",
        "proseLatex": "TIR needs BOTH: travel from denser ($n_1$) toward rarer ($n_2 < n_1$), AND $i > \\theta_c$ with $\\sin\\theta_c = \\frac{n_2}{n_1}$ ($1/n$ into air). Rarer-to-denser TIR is IMPOSSIBLE at any angle. Micro-check: water-air: $\\theta_c = \\sin^{-1}(3/4) \\approx 48.6^\\circ$."
      },
      {
        "prdId": "P13-PRD04",
        "heading": "Optical Fibres & the Submerged Bulb Disc",
        "proseLatex": "Step-index fibre: core $n_1$ > cladding $n_2$ (never reversed), acceptance $\\text{NA} = \\sin\\theta_{\\text{acc}} = \\sqrt{n_1^2 - n_2^2}$. A point source at depth $h$ lights a surface disc of radius $R = \\frac{h}{\\sqrt{n^2 - 1}}$. Micro-check: $n = 1.5$, $h = 5$: $R = \\frac{5}{\\sqrt{1.25}} \\approx 4.47\\,\\text{m}$."
      },
      {
        "prdId": "P13-PRD05",
        "heading": "Prism: Geometry & Minimum Deviation",
        "proseLatex": "Prism relations: $r_1 + r_2 = A$ and $\\delta = i + e - A$. At minimum deviation the passage is symmetric ($i = e$, $r_1 = r_2 = A/2$), giving $n = \\frac{\\sin\\frac{A + \\delta_m}{2}}{\\sin\\frac{A}{2}}$. Thin prism ($A \\lesssim 10^\\circ$): $\\delta \\approx (n - 1)A$. Micro-check: $A = 60^\\circ$, $\\delta_m = 40^\\circ$: $n = \\frac{\\sin 50^\\circ}{\\sin 30^\\circ} = \\frac{0.766}{0.5} = 1.53$."
      },
      {
        "prdId": "P13-PRD06",
        "heading": "Frequency Never Changes",
        "proseLatex": "Colour is set by frequency: on refraction only $v = c/n$ and $\\lambda = \\lambda_0/n$ change; photon energy $h\\nu$ is untouched. Dispersion (prisms, rainbows) arises because $n$ varies with frequency. Micro-check: red light entering glass slows and shortens but stays red."
      }
    ],
