  "unitId": "P06",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "P06-PRD01",
        "heading": "Stress, Strain & the Three Moduli",
        "proseLatex": "Within the proportional limit, stress $\\sigma = F/A$ ($\\text{Pa}$) is proportional to dimensionless strain $\\varepsilon$ (Hooke's law). Young's modulus $Y = \\frac{FL}{A\\Delta L}$ (wire stiffness $k = \\frac{YA}{L}$); bulk modulus $K = -\\frac{\\Delta P}{\\Delta V/V}$ (compressibility $\\beta = 1/K$); rigidity modulus $\\eta = \\frac{F_t/A}{\\theta}$ for shear. Steel is MORE elastic than rubber — higher $Y$! Micro-check: $Y = 2\\times10^{11}$, $L = 2$, $A = 10^{-6}$, $F = 100$: $\\Delta L = \\frac{100\\times2}{2\\times10^{11}\\times10^{-6}} = 10^{-3}\\,\\text{m}$."
      },
      {
        "prdId": "P06-PRD02",
        "heading": "Poisson's Ratio & Its Bounds",
        "proseLatex": "$\\nu = -\\frac{\\Delta r/r}{\\Delta L/L}$ with thermodynamic bounds $-1 \\le \\nu \\le 0.5$ (metals: $0 < \\nu < 0.5$). At $\\nu = 0.5$ volume is conserved: $\\frac{\\Delta V}{V} = (1 - 2\\nu)\\frac{\\Delta L}{L} = 0$. Micro-check: $\\nu = 0.3$, $\\Delta L/L = 0.1\\%$: $\\Delta r/r = -0.03\\%$."
      },
      {
        "prdId": "P06-PRD03",
        "heading": "Inter-Modulus Relations",
        "proseLatex": "Isotropic solids obey $Y = 3K(1 - 2\\nu) = 2\\eta(1 + \\nu)$ — three moduli, two independent. Micro-check: $\\nu = 0.25$: $Y = 1.5K$ and $Y = 2.5\\eta$."
      },
      {
        "prdId": "P06-PRD04",
        "heading": "Elastic Potential Energy & Density",
        "proseLatex": "Slow stretch stores $U = \\frac{1}{2}F\\Delta L$ (a dropped dead weight stores only half its $mg\\Delta L$; the other half dissipates as heat). Energy density $u = \\frac{U}{AL} = \\frac{1}{2}\\sigma\\varepsilon = \\frac{\\sigma^2}{2Y} = \\frac{1}{2}Y\\varepsilon^2$. Micro-check: $\\sigma = 2\\times10^8$, $Y = 2\\times10^{11}$: $u = \\frac{4\\times10^{16}}{4\\times10^{11}} = 10^5\\,\\text{J/m}^3$."
      },
      {
        "prdId": "P06-PRD05",
        "heading": "Clamped Thermal Stress",
        "proseLatex": "A rod rigidly clamped between walls and heated by $\\Delta T$ develops compressive stress $\\sigma = Y\\alpha\\Delta T$ and force $F = YA\\alpha\\Delta T$ — fully independent of length $L$. Micro-check: $Y = 2\\times10^{11}$, $\\alpha = 1.2\\times10^{-5}$, $\\Delta T = 50$: $\\sigma = 1.2\\times10^8\\,\\text{Pa}$."
      },
      {
        "prdId": "P06-PRD06",
        "heading": "Material vs Geometry: What Changes What",
        "proseLatex": "$Y$ is intrinsic to the MATERIAL: doubling $L$ or halving $A$ changes $\\Delta L$ and $k$ but never $Y$. Elasticity ranking (steel $>$ rubber) is about $Y$, not stretchiness. Micro-check: same wire stretched with double force: $\\Delta L$ doubles, $Y$ unchanged."
      }
    ],
