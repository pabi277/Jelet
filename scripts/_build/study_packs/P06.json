    "mcqSelfTest": [
      {
        "mcqId": "P06-MCQ01",
        "stemLatex": "A wire ($Y = 2\\times10^{11}\\,\\text{Pa}$, $L = 2\\,\\text{m}$, $A = 10^{-6}\\,\\text{m}^2$) carries $100\\,\\text{N}$. Its extension is:",
        "options": [
          {
            "id": "A",
            "latex": "$1\\,\\text{mm}$"
          },
          {
            "id": "B",
            "latex": "$2\\,\\text{mm}$"
          },
          {
            "id": "C",
            "latex": "$0.5\\,\\text{mm}$"
          },
          {
            "id": "D",
            "latex": "$1\\,\\text{cm}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$\\Delta L = \\frac{FL}{AY} = \\frac{200}{2\\times10^5} = 10^{-3}\\,\\text{m}$."
      },
      {
        "mcqId": "P06-MCQ02",
        "stemLatex": "Which material is MORE elastic in the physics sense?",
        "options": [
          {
            "id": "A",
            "latex": "rubber"
          },
          {
            "id": "B",
            "latex": "steel"
          },
          {
            "id": "C",
            "latex": "glass"
          },
          {
            "id": "D",
            "latex": "water"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "Higher $Y$ means more elastic: steel $>$ rubber."
      },
      {
        "mcqId": "P06-MCQ03",
        "stemLatex": "Doubling a wire's length (same material, same $A$) changes $Y$ by:",
        "options": [
          {
            "id": "A",
            "latex": "doubles it"
          },
          {
            "id": "B",
            "latex": "halves it"
          },
          {
            "id": "C",
            "latex": "no change"
          },
          {
            "id": "D",
            "latex": "quadruples it"
          }
        ],
        "correct": [
          "C"
        ],
        "explanation": "$Y$ is a material property — geometry changes $k$ and $\\Delta L$, never $Y$."
      },
      {
        "mcqId": "P06-MCQ04",
        "stemLatex": "For $\\nu = 0.5$, the volume change on stretching is:",
        "options": [
          {
            "id": "A",
            "latex": "positive"
          },
          {
            "id": "B",
            "latex": "negative"
          },
          {
            "id": "C",
            "latex": "zero"
          },
          {
            "id": "D",
            "latex": "doubled"
          }
        ],
        "correct": [
          "C"
        ],
        "explanation": "$(1 - 2\\nu) = 0$: volume conserved — incompressible limit."
      },
      {
        "mcqId": "P06-MCQ05",
        "stemLatex": "With $\\nu = 0.25$, the relation $Y : K$ equals:",
        "options": [
          {
            "id": "A",
            "latex": "$1.5$"
          },
          {
            "id": "B",
            "latex": "$2.5$"
          },
          {
            "id": "C",
            "latex": "$0.5$"
          },
          {
            "id": "D",
            "latex": "$1$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$Y = 3K(1 - 0.5) = 1.5K$."
      },
      {
        "mcqId": "P06-MCQ06",
        "stemLatex": "Elastic energy density in terms of $\\sigma$ and $Y$ is:",
        "options": [
