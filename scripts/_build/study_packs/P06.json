            "latex": "$0 \\le \\nu \\le 1$"
          },
          {
            "id": "B",
            "latex": "$-1 \\le \\nu \\le 0.5$"
          },
          {
            "id": "C",
            "latex": "$0.5 \\le \\nu \\le 1$"
          },
          {
            "id": "D",
            "latex": "$-0.5 \\le \\nu \\le 0$"
          }
        ],
        "correct": [
