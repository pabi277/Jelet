        "stemLatex": "The projection of $\\vec{a} = 3\\hat{i} + 4\\hat{j}$ on $\\vec{b} = 2\\hat{i}$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$3$"
          },
          {
            "id": "B",
