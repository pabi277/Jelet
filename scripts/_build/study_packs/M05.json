        "label": "Cross product magnitude",
        "latex": "|\\vec{a}\\times\\vec{b}| = |\\vec{a}||\\vec{b}|\\sin\\theta",
        "use": "Anti-commutative vector."
      },
      {
        "sfId": "M05-SF07",
        "label": "Parallelogram / triangle area",
        "latex": "|\\vec{a}\\times\\vec{b}|;\\quad \\frac{1}{2}|\\vec{a}\\times\\vec{b}|",
        "use": "Adjacent-side areas."
      },
      {
        "sfId": "M05-SF08",
        "label": "Lagrange's identity",
        "latex": "|\\vec{a}\\times\\vec{b}|^2 + (\\vec{a}\\cdot\\vec{b})^2 = |\\vec{a}|^2|\\vec{b}|^2",
        "use": "Angle-free conversion."
      },
      {
        "sfId": "M05-SF09",
        "label": "Scalar triple product",
        "latex": "[\\vec{a}\\;\\vec{b}\\;\\vec{c}] = \\vec{a}\\cdot(\\vec{b}\\times\\vec{c})",
        "use": "Component determinant."
      },
      {
        "sfId": "M05-SF10",
        "label": "Coplanarity condition",
        "latex": "[\\vec{a}\\;\\vec{b}\\;\\vec{c}] = 0",
        "use": "Zero volume."
      },
      {
        "sfId": "M05-SF11",
        "label": "Cyclic invariance",
        "latex": "[\\vec{a}\\;\\vec{b}\\;\\vec{c}] = [\\vec{b}\\;\\vec{c}\\;\\vec{a}] = [\\vec{c}\\;\\vec{a}\\;\\vec{b}]",
        "use": "Even permutations keep sign."
      },
      {
        "sfId": "M05-SF12",
        "label": "BAC-CAB rule",
        "latex": "\\vec{a}\\times(\\vec{b}\\times\\vec{c}) = (\\vec{a}\\cdot\\vec{c})\\vec{b} - (\\vec{a}\\cdot\\vec{b})\\vec{c}",
        "use": "Vector triple product."
      },
      {
        "sfId": "M05-SF13",
        "label": "Sum-cycle triple product",
        "latex": "[\\vec{a}+\\vec{b},\\ \\vec{b}+\\vec{c},\\ \\vec{c}+\\vec{a}] = 2[\\vec{a}\\;\\vec{b}\\;\\vec{c}]",
        "use": "Classic JELET identity."
      },
      {
        "sfId": "M05-SF14",
        "label": "Difference-cycle triple product",
        "latex": "[\\vec{a}-\\vec{b},\\ \\vec{b}-\\vec{c},\\ \\vec{c}-\\vec{a}] = 0",
        "use": "Always coplanar."
      }
    ],
    "keyDefinitions": [
      {
        "defId": "M05-DEF01",
        "term": "Unit vector",
        "definition": "Vector of length 1 along the given direction: $\\vec{r}/|\\vec{r}|$."
      },
      {
        "defId": "M05-DEF02",
        "term": "Direction cosines",
        "definition": "Cosines of the angles a direction makes with the axes; satisfy $l^2+m^2+n^2 = 1$."
      },
      {
        "defId": "M05-DEF03",
        "term": "Scalar (dot) product",
        "definition": "Scalar $|\\vec{a}||\\vec{b}|\\cos\\theta$; zero exactly for perpendicular nonzero vectors."
      },
      {
        "defId": "M05-DEF04",
        "term": "Projection",
        "definition": "Component of $\\vec{a}$ along $\\vec{b}$: $\\frac{\\vec{a}\\cdot\\vec{b}}{|\\vec{b}|}$."
      },
      {
        "defId": "M05-DEF05",
        "term": "Vector (cross) product",
        "definition": "Anti-commutative vector $|\\vec{a}||\\vec{b}|\\sin\\theta\\,\\hat{n}$; zero for collinear vectors."
      },
      {
        "defId": "M05-DEF06",
        "term": "Scalar triple product",
        "definition": "Signed volume $\\vec{a}\\cdot(\\vec{b}\\times\\vec{c})$ of the parallelepiped on three vectors."
      },
      {
        "defId": "M05-DEF07",
        "term": "Coplanar vectors",
        "definition": "Triple product zero — the three vectors share one plane."
      },
      {
        "defId": "M05-DEF08",
        "term": "Vector triple product",
        "definition": "$\\vec{a}\\times(\\vec{b}\\times\\vec{c})$, expanded by BAC-CAB; not associative."
      }
    ],
