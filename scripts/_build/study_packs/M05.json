{
  "unitId": "M05",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "M05-PRD01",
        "heading": "Magnitude, Unit Vectors & Direction Cosines",
        "proseLatex": "For $\\vec{r} = x\\hat{i} + y\\hat{j} + z\\hat{k}$: $|\\vec{r}| = \\sqrt{x^2+y^2+z^2}$ and $\\hat{r} = \\vec{r}/|\\vec{r}|$. Direction cosines $(l, m, n) = (\\cos\\alpha, \\cos\\beta, \\cos\\gamma)$ always satisfy $l^2 + m^2 + n^2 = 1$. Micro-check: $\\vec{r} = 2\\hat{i} - \\hat{j} + 2\\hat{k}$ has $|\\vec{r}| = 3$ and $\\hat{r} = \\left(\\frac{2}{3}, -\\frac{1}{3}, \\frac{2}{3}\\right)$; squares sum to $1$."
      },
      {
        "prdId": "M05-PRD02",
        "heading": "Dot Product: Orthogonality Test & Projection",
        "proseLatex": "$\\vec{a}\\cdot\\vec{b} = |\\vec{a}||\\vec{b}|\\cos\\theta = a_1b_1 + a_2b_2 + a_3b_3$ is a scalar; $\\vec{a}\\perp\\vec{b} \\iff \\vec{a}\\cdot\\vec{b} = 0$. Projection of $\\vec{a}$ ON $\\vec{b}$ divides by $|\\vec{b}|$ (not $|\\vec{a}|$): $\\frac{\\vec{a}\\cdot\\vec{b}}{|\\vec{b}|}$. Micro-check: $\\vec{a} = (1, 2, 3)$, $\\vec{b} = (4, -2, 0)$: $\\vec{a}\\cdot\\vec{b} = 4 - 4 + 0 = 0$ — perpendicular."
      },
      {
        "prdId": "M05-PRD03",
        "heading": "Cross Product: Orientation & Area",
        "proseLatex": "$\\vec{a}\\times\\vec{b} = |\\vec{a}||\\vec{b}|\\sin\\theta\\,\\hat{n}$ is anti-commutative ($\\vec{b}\\times\\vec{a} = -\\vec{a}\\times\\vec{b}$) and vanishes exactly for nonzero collinear vectors. $|\\vec{a}\\times\\vec{b}|$ is the parallelogram area on adjacent sides $\\vec{a}, \\vec{b}$; the triangle area is $\\frac{1}{2}|\\vec{a}\\times\\vec{b}|$. Micro-check: $\\vec{a} = \\hat{i} + \\hat{j}$, $\\vec{b} = \\hat{i} - \\hat{j}$: $\\vec{a}\\times\\vec{b} = -2\\hat{k}$, so areas $2$ and $1$."
      },
      {
        "prdId": "M05-PRD04",
        "heading": "Lagrange's Identity: Dot + Cross Without $\\theta$",
        "proseLatex": "$|\\vec{a}\\times\\vec{b}|^2 + (\\vec{a}\\cdot\\vec{b})^2 = |\\vec{a}|^2|\\vec{b}|^2$ converts between dot and cross magnitudes with no angle in sight. Micro-check: $|\\vec{a}| = 3$, $|\\vec{b}| = 4$, $\\theta = 60°$: $\\vec{a}\\cdot\\vec{b} = 6$, so $|\\vec{a}\\times\\vec{b}| = \\sqrt{144 - 36} = \\sqrt{108} = 6\\sqrt{3}$ — exactly $12\\sin 60°$."
      },
      {
        "prdId": "M05-PRD05",
        "heading": "Scalar Triple Product: Volume & Coplanarity",
        "proseLatex": "$[\\vec{a}\\;\\vec{b}\\;\\vec{c}] = \\vec{a}\\cdot(\\vec{b}\\times\\vec{c})$ is the $3\\times 3$ component determinant: the signed parallelepiped volume. $[\\vec{a}\\;\\vec{b}\\;\\vec{c}] = 0$ is the exact coplanarity condition, and cyclic shifts preserve it: $[\\vec{a}\\;\\vec{b}\\;\\vec{c}] = [\\vec{b}\\;\\vec{c}\\;\\vec{a}] = [\\vec{c}\\;\\vec{a}\\;\\vec{b}]$. Micro-check: $[\\vec{a}+\\vec{b},\\ \\vec{b}+\\vec{c},\\ \\vec{c}+\\vec{a}] = 2[\\vec{a}\\;\\vec{b}\\;\\vec{c}]$ — double, never zero (unless the original is)."
      },
      {
        "prdId": "M05-PRD06",
        "heading": "Vector Triple Product: BAC-CAB (and Non-Associativity)",
        "proseLatex": "$\\vec{a}\\times(\\vec{b}\\times\\vec{c}) = (\\vec{a}\\cdot\\vec{c})\\vec{b} - (\\vec{a}\\cdot\\vec{b})\\vec{c}$ — the BAC-CAB expansion always lands in the plane of $\\vec{b}$ and $\\vec{c}$. The brackets matter: $\\vec{a}\\times(\\vec{b}\\times\\vec{c}) \\neq (\\vec{a}\\times\\vec{b})\\times\\vec{c}$ in general. Micro-check: $\\vec{a} = \\hat{i}$, $\\vec{b} = \\hat{j}$, $\\vec{c} = \\hat{i} + \\hat{j}$: $\\vec{a}\\times(\\vec{b}\\times\\vec{c}) = (1)\\hat{j} - (0)\\vec{c} = \\hat{j}$."
      }
    ],
    "keyFormulas": [
      {
        "sfId": "M05-SF01",
        "label": "Magnitude & unit vector",
        "latex": "|\\vec{r}| = \\sqrt{x^2+y^2+z^2};\\quad \\hat{r} = \\frac{\\vec{r}}{|\\vec{r}|}",
