        ],
        "explanation": "$\\vec{a}\\times\\vec{b} = -2\\hat{k}$, magnitude $2$; the triangle on the same sides would be $1$."
      },
      {
        "mcqId": "M05-MCQ05",
        "stemLatex": "If $|\\vec{a}| = 3$, $|\\vec{b}| = 4$ and $\\theta = 60°$, then $|\\vec{a}\\times\\vec{b}|$ equals:",
        "options": [
