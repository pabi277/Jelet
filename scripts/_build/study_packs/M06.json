    "mcqSelfTest": [
      {
        "mcqId": "M06-MCQ01",
        "stemLatex": "$\\lim_{x\\to 0}(1 + 3x)^{2/x}$ equals:",
        "options": [
          {
            "id": "A",
            "latex": "$e^2$"
          },
          {
            "id": "B",
            "latex": "$e^3$"
          },
          {
            "id": "C",
            "latex": "$e^6$"
          },
          {
            "id": "D",
            "latex": "$1$"
          }
        ],
        "correct": [
          "C"
        ],
        "explanation": "$1^\\infty$ collapse: $e^{\\lim 3x\\cdot 2/x} = e^6$."
      },
      {
        "mcqId": "M06-MCQ02",
        "stemLatex": "$\\lim_{x\\to 0}\\frac{\\sin 5x}{3x}$ equals:",
        "options": [
          {
            "id": "A",
            "latex": "$\\frac{5}{3}$"
          },
          {
            "id": "B",
            "latex": "$\\frac{3}{5}$"
          },
          {
            "id": "C",
            "latex": "$1$"
          },
          {
            "id": "D",
            "latex": "$0$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$0/0$: L'Hospital gives $\\frac{5\\cos 5x}{3} \\to \\frac{5}{3}$."
      },
      {
        "mcqId": "M06-MCQ03",
        "stemLatex": "At $x = 2$, $f(x) = |x - 2|$ is:",
        "options": [
          {
            "id": "A",
            "latex": "continuous and differentiable"
          },
          {
            "id": "B",
            "latex": "continuous but not differentiable"
          },
          {
            "id": "C",
            "latex": "differentiable but not continuous"
          },
          {
            "id": "D",
            "latex": "neither"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "Corner point: both one-sided limits equal $0$ (continuous) but slopes $\\pm 1$ disagree."
      },
      {
        "mcqId": "M06-MCQ04",
        "stemLatex": "For $x = t^2$, $y = t^3$, $\\frac{dy}{dx}$ at $t = 2$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$3$"
          },
          {
            "id": "B",
            "latex": "$6$"
          },
          {
            "id": "C",
            "latex": "$2$"
          },
          {
            "id": "D",
            "latex": "$\\frac{3}{2}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$\\frac{\\dot{y}}{\\dot{x}} = \\frac{3t^2}{2t} = \\frac{3t}{2} = 3$ at $t = 2$."
      },
      {
        "mcqId": "M06-MCQ05",
        "stemLatex": "For $x = t^2$, $y = t^3$, $\\frac{d^2y}{dx^2}$ at $t = 1$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$\\frac{3}{4}$"
          },
          {
            "id": "B",
            "latex": "$\\frac{3}{2}$"
          },
          {
            "id": "C",
            "latex": "$3$"
          },
          {
            "id": "D",
            "latex": "$\\frac{1}{2}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$\\frac{d}{dt}(3t/2)\\cdot\\frac{1}{2t} = \\frac{3/2}{2t} = \\frac{3}{4t} = \\frac{3}{4}$ at $t = 1$."
      },
      {
        "mcqId": "M06-MCQ06",
        "stemLatex": "The derivative of $y = x^x$ at $x = 1$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$1$"
          },
          {
            "id": "B",
            "latex": "$2$"
          },
          {
            "id": "C",
            "latex": "$e$"
          },
          {
            "id": "D",
            "latex": "$\\ln 2$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$y' = x^x(1 + \\ln x)$; at $x = 1$: $1\\cdot(1 + 0) = 1$."
      },
      {
        "mcqId": "M06-MCQ07",
        "stemLatex": "Rolle's theorem applied to $f(x) = x^2 - 4x + 3$ on $[1, 3]$ gives $c$ equal to:",
        "options": [
          {
            "id": "A",
            "latex": "$1$"
          },
          {
            "id": "B",
            "latex": "$2$"
          },
          {
            "id": "C",
            "latex": "$3$"
          },
          {
            "id": "D",
            "latex": "$4$"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "$f(1) = f(3) = 0$; $f'(c) = 2c - 4 = 0 \\Rightarrow c = 2 \\in (1, 3)$."
      },
      {
        "mcqId": "M06-MCQ08",
        "stemLatex": "Lagrange's MVT for $f(x) = x^2$ on $[1, 3]$ gives $c$ equal to:",
        "options": [
          {
            "id": "A",
            "latex": "$2$"
          },
          {
            "id": "B",
            "latex": "$2.5$"
          },
          {
            "id": "C",
            "latex": "$1.5$"
          },
          {
            "id": "D",
            "latex": "$3$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$2c = \\frac{9 - 1}{2} = 4 \\Rightarrow c = 2$."
      },
      {
        "mcqId": "M06-MCQ09",
        "stemLatex": "$\\frac{d^3}{dx^3}\\sin 2x$ equals:",
        "options": [
          {
            "id": "A",
            "latex": "$8\\cos 2x$"
          },
          {
            "id": "B",
            "latex": "$-8\\cos 2x$"
          },
          {
            "id": "C",
            "latex": "$2\\cos 2x$"
          },
          {
            "id": "D",
            "latex": "$-2\\cos 2x$"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "$2^3\\sin(2x + \\frac{3\\pi}{2}) = 8(-\\cos 2x) = -8\\cos 2x$."
      },
      {
        "mcqId": "M06-MCQ10",
        "stemLatex": "In $(uv)_2 = u_2 v + k\\,u_1 v_1 + u v_2$, the coefficient $k$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$1$"
          },
          {
            "id": "B",
            "latex": "$2$"
          },
          {
            "id": "C",
            "latex": "$3$"
          },
          {
            "id": "D",
            "latex": "$n$"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "Leibniz: middle term carries $\\binom{2}{1} = 2$."
      }
    ],
    "memoryHooks": [
      "Limit needs both sides; continuity pins the value.",
      "$1^\\infty$? Write $e^{\\lim u\\,v}$ and move on.",
      "Verify $0/0$ BEFORE L'Hospital — never on a hunch.",
      "Corner $|x|$: continuous yes, differentiable no.",
      "Parametric second derivative: differentiate $dy/dx$ w.r.t. $t$, then divide by $\\dot{x}$.",
      "$x^x$: $x^x(1 + \\ln x)$ — log first, chain second.",
      "Rolle = equal ends $\\to$ flat spot; Lagrange = secant slope matched.",
      "$|x|$, $x^{2/3}$: Rolle fails where $f'$ doesn't exist.",
      "Leibniz coefficients: Pascal's triangle row.",
      "$\\sin$ ladder: add $\\frac{n\\pi}{2}$, scale by $a^n$."
    ],
    "commonMistakes": [
      "Applying L'Hospital to a ratio that isn't $0/0$ or $\\infty/\\infty$.",
      "Writing $\\frac{d^2y}{dx^2} = \\frac{\\ddot{y}}{\\ddot{x}}$ for parametric curves.",
      "Forgetting the $1/\\dot{x}$ factor in parametric second derivatives.",
      "Claiming differentiability for corner points.",
      "Using Rolle when $f(a) \\neq f(b)$ or $f'$ has an interior gap.",
      "Mis-expanding $x^x$ without the logarithmic step.",
      "Dropping the phase shift $\\frac{n\\pi}{2}$ in $n$-th derivative ladders.",
      "Leibniz coefficients from memory instead of $\\binom{n}{r}$."
    ],
    "examChecklist": [
      "Split limits into one-sided pieces at piecewise joins.",
      "Confirm the indeterminate form, then pick L'Hospital or series.",
      "Deploy $e^{\\lim u\\,v}$ for every $1^\\infty$ limit.",
      "Test differentiability with one-sided slopes at suspect points.",
      "Parametric: $\\dot{y}/\\dot{x}$ then the $1/\\dot{x}$ correction.",
      "Logarithmic differentiation for $u^v$ functions.",
      "Verify Rolle/MVT hypotheses before solving for $c$.",
      "Leibniz with binomial coefficients for $(uv)_n$.",
      "Quote $\\sin/\\cos/e^{ax}$ $n$-th derivative ladders directly.",
      "Check $c \\in (a, b)$ at the end of every MVT question."
    ],
