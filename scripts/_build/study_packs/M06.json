{
  "unitId": "M06",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "M06-PRD01",
        "heading": "Limits, One-Sided Existence & the $1^\\infty$ Collapse",
        "proseLatex": "A limit exists iff $f(a^-) = f(a^+) = L$ finitely; continuity adds $L = f(a)$. For $\\lim_{x\\to a}[1 + u(x)]^{v(x)}$ with $u \\to 0$, $v \\to \\infty$, the $1^\\infty$ form collapses to $e^{\\lim u(x)v(x)}$. Micro-check: $\\lim_{x\\to 0}(1 + 3x)^{1/x} = e^{\\lim 3x \\cdot 1/x} = e^3$."
      },
      {
        "prdId": "M06-PRD02",
        "heading": "L'Hospital & Series Rescue for $0/0$",
        "proseLatex": "For genuine $0/0$ or $\\infty/\\infty$ ratios, $\\lim\\frac{f}{g} = \\lim\\frac{f'}{g'}$ (verify the form FIRST — trap); Maclaurin series give the same answers by expansion. Micro-check: $\\lim_{x\\to 0}\\frac{\\sin 5x}{3x} = \\frac{5\\cos 5x}{3}\\Big|_0 = \\frac{5}{3}$."
      },
      {
        "prdId": "M06-PRD03",
        "heading": "Differentiability & the Parametric Machine",
        "proseLatex": "Differentiability at $a$ needs $f'(a^-) = f'(a^+)$ finitely; differentiable $\\Rightarrow$ continuous, but $|x|$ shows the converse fails. For $x = x(t), y = y(t)$: $\\frac{dy}{dx} = \\frac{\\dot{y}}{\\dot{x}}$ and $\\frac{d^2y}{dx^2} = \\frac{d}{dt}\\!\\left(\\frac{dy}{dx}\\right)\\cdot\\frac{1}{\\dot{x}}$ — never $\\ddot{y}/\\ddot{x}$ (trap). Micro-check: $x = t^2, y = t^3$: $\\frac{dy}{dx} = \\frac{3t}{2}$, $\\frac{d^2y}{dx^2} = \\frac{3/2}{2t} = \\frac{3}{4t}$."
      },
      {
        "prdId": "M06-PRD04",
        "heading": "Variable Exponents: Logarithmic Differentiation",
        "proseLatex": "$y = u(x)^{v(x)}$: take logs, $\\ln y = v\\ln u$, then $y' = u^v\\left(v'\\ln u + \\frac{v\\,u'}{u}\\right)$. Micro-check: $y = x^x$ gives $y' = x^x(1 + \\ln x)$; at $x = 1$ the slope is $1$."
      },
      {
        "prdId": "M06-PRD05",
        "heading": "Rolle & Lagrange's Mean Value Theorem",
        "proseLatex": "Continuous on $[a, b]$, differentiable on $(a, b)$: Lagrange guarantees $c$ with $f'(c) = \\frac{f(b)-f(a)}{b-a}$; Rolle is the $f(a) = f(b)$ special case giving $f'(c) = 0$. Both fail if $f'$ doesn't exist inside (trap: $|x|$, $x^{2/3}$ at $0$). Micro-check: $f = x^2$ on $[1, 3]$: $2c = 4 \\Rightarrow c = 2 \\in (1, 3)$."
      },
      {
        "prdId": "M06-PRD06",
        "heading": "Leibniz Rule & Standard $n$-th Derivative Shifts",
        "proseLatex": "$(uv)_n = \\sum_{r=0}^{n}\\binom{n}{r}u_{n-r}v_r$ handles product $n$-th derivatives; shifts: $\\frac{d^n}{dx^n}\\sin(ax+b) = a^n\\sin\\left(ax+b+\\frac{n\\pi}{2}\\right)$ and $\\frac{d^n}{dx^n}e^{ax} = a^n e^{ax}$. Micro-check: third derivative of $\\sin 2x$ is $8\\sin(2x + \\frac{3\\pi}{2}) = -8\\cos 2x$."
      }
    ],
    "keyFormulas": [
      {
        "sfId": "M06-SF01",
        "label": "Limit existence",
        "latex": "f(a^-) = f(a^+) = L",
        "use": "Both one-sided limits agree."
      },
      {
        "sfId": "M06-SF02",
        "label": "Continuity at $a$",
        "latex": "L = f(a)",
        "use": "Limit equals value."
      },
      {
        "sfId": "M06-SF03",
        "label": "L'Hospital's rule",
        "latex": "\\lim\\frac{f}{g} = \\lim\\frac{f'}{g'}",
        "use": "Only for true $0/0$ or $\\infty/\\infty$."
      },
      {
        "sfId": "M06-SF04",
        "label": "$1^\\infty$ collapse",
        "latex": "\\lim [1+u]^{v} = e^{\\lim u\\,v}",
        "use": "$u \\to 0$, $v \\to \\infty$."
      },
      {
        "sfId": "M06-SF05",
        "label": "Differentiability test",
        "latex": "f'(a^-) = f'(a^+) \\ \\text{finite}",
        "use": "Smoothness criterion."
      },
      {
        "sfId": "M06-SF06",
        "label": "Parametric first derivative",
        "latex": "\\frac{dy}{dx} = \\frac{\\dot{y}}{\\dot{x}}",
        "use": "Divide the $t$-rates."
      },
      {
        "sfId": "M06-SF07",
        "label": "Parametric second derivative",
        "latex": "\\frac{d^2y}{dx^2} = \\frac{d}{dt}\\left(\\frac{dy}{dx}\\right)\\cdot\\frac{1}{\\dot{x}}",
        "use": "The extra $1/\\dot{x}$ factor."
      },
      {
        "sfId": "M06-SF08",
        "label": "Variable-exponent derivative",
        "latex": "y' = u^v\\left(v'\\ln u + \\frac{v u'}{u}\\right)",
        "use": "For $y = u(x)^{v(x)}$."
      },
      {
        "sfId": "M06-SF09",
        "label": "Lagrange's MVT",
        "latex": "f'(c) = \\frac{f(b)-f(a)}{b-a}",
        "use": "Some $c \\in (a, b)$."
      },
      {
        "sfId": "M06-SF10",
        "label": "Rolle's theorem",
        "latex": "f(a) = f(b) \\Rightarrow f'(c) = 0",
        "use": "Special MVT case."
      },
      {
        "sfId": "M06-SF11",
        "label": "Leibniz rule",
        "latex": "(uv)_n = \\sum_{r=0}^{n} \\binom{n}{r} u_{n-r} v_r",
        "use": "Product $n$-th derivative."
      },
      {
        "sfId": "M06-SF12",
        "label": "$n$-th derivative of $\\sin(ax+b)$",
        "latex": "a^n \\sin\\left(ax+b+\\frac{n\\pi}{2}\\right)",
        "use": "Phase-shift ladder."
      },
      {
        "sfId": "M06-SF13",
        "label": "$n$-th derivative of $\\cos(ax+b)$",
        "latex": "a^n \\cos\\left(ax+b+\\frac{n\\pi}{2}\\right)",
        "use": "Phase-shift ladder."
      },
      {
        "sfId": "M06-SF14",
        "label": "$n$-th derivative of $e^{ax}$",
        "latex": "a^n e^{ax}",
        "use": "Pure scaling."
      }
    ],
    "keyDefinitions": [
      {
        "defId": "M06-DEF01",
        "term": "Limit",
        "definition": "Value $L$ approached as $x \\to a$; exists iff both one-sided limits agree finitely."
      },
      {
        "defId": "M06-DEF02",
        "term": "Continuity",
        "definition": "Limit equals function value at the point."
      },
      {
        "defId": "M06-DEF03",
        "term": "Differentiability",
        "definition": "Finitely equal left and right derivatives at the point."
      },
      {
        "defId": "M06-DEF04",
        "term": "Indeterminate form",
        "definition": "$0/0$, $\\infty/\\infty$, $1^\\infty$ etc. — needs L'Hospital, series, or the $1^\\infty$ collapse."
      },
      {
        "defId": "M06-DEF05",
        "term": "L'Hospital's rule",
        "definition": "Ratio-of-derivatives evaluation valid only for true indeterminate ratios."
      },
      {
        "defId": "M06-DEF06",
        "term": "Parametric derivative",
        "definition": "$dy/dx$ obtained from $t$-rates: $\\dot{y}/\\dot{x}$."
      },
      {
        "defId": "M06-DEF07",
        "term": "Rolle's theorem",
        "definition": "$f(a) = f(b)$ with smoothness $\\Rightarrow$ a horizontal tangent exists inside."
      },
      {
        "defId": "M06-DEF08",
        "term": "Mean value theorem (Lagrange)",
        "definition": "Some interior $c$ matches the secant slope."
      },
      {
        "defId": "M06-DEF09",
        "term": "Leibniz rule",
        "definition": "Binomial-coefficient formula for the $n$-th derivative of a product."
      }
    ],
