{
  "unitId": "M10",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "M10-PRD01",
        "heading": "Order, Degree & the Linear ODE Machine",
        "proseLatex": "Order = highest derivative present; degree = its positive-integer exponent AFTER clearing radicals/fractions in derivatives — undefined if a derivative sits inside $\\sin$, $e^{(\\cdot)}$ or $\\ln$. First-order linear $\\frac{dy}{dx} + P(x)y = Q(x)$: normalize by the $y'$ coefficient FIRST, then IF $= e^{\\int P\\,dx}$ and $y\\cdot\\text{IF} = \\int Q\\cdot\\text{IF}\\,dx + C$. Micro-check: $\\frac{dy}{dx} + \\frac{y}{x} = x^2$: IF $= x$, so $yx = \\frac{x^4}{4} + C$."
      },
      {
        "prdId": "M10-PRD02",
        "heading": "Exact Equations: the $M_y = N_x$ Test",
        "proseLatex": "$M\\,dx + N\\,dy = 0$ is exact iff $\\frac{\\partial M}{\\partial y} = \\frac{\\partial N}{\\partial x}$; then $F = \\text{const}$ with $F_x = M$, $F_y = N$. Micro-check: $2xy\\,dx + x^2\\,dy = 0$: $M_y = 2x = N_x$ — exact, and $d(x^2y) = 2xy\\,dx + x^2\\,dy$, so $x^2y = C$."
      },
      {
        "prdId": "M10-PRD03",
        "heading": "Homogeneous Equations: the $y = vx$ Reduction",
        "proseLatex": "$\\frac{dy}{dx} = \\phi(y/x)$ becomes separable under $y = vx$: $v + x\\frac{dv}{dx} = \\phi(v)$. Micro-check: $\\frac{dy}{dx} = \\frac{x+y}{x} = 1 + \\frac{y}{x}$: $x v' = 1 \\Rightarrow v = \\ln x + C \\Rightarrow y = x\\ln x + Cx$."
      },
      {
        "prdId": "M10-PRD04",
        "heading": "Bernoulli: One Substitution to Linear",
        "proseLatex": "$\\frac{dy}{dx} + Py = Qy^n$ ($n \\neq 0, 1$): divide by $y^n$, set $u = y^{1-n}$, obtaining the linear ODE $\\frac{du}{dx} + (1-n)Pu = (1-n)Q$. Micro-check: $n = 3$: $u = y^{-2}$ and $\\frac{du}{dx} - 2Pu = -2Q$."
      },
      {
        "prdId": "M10-PRD05",
        "heading": "Second-Order CF: Read the Auxiliary Roots",
        "proseLatex": "$(aD^2 + bD + c)y = 0$: roots of $am^2 + bm + c = 0$ decide $y_{\\text{CF}}$ — distinct real $m_1, m_2$: $c_1e^{m_1x} + c_2e^{m_2x}$; repeated $m$: $(c_1 + c_2x)e^{mx}$; complex $\\alpha \\pm i\\beta$: $e^{\\alpha x}(c_1\\cos\\beta x + c_2\\sin\\beta x)$. Micro-check: $y'' - 5y' + 6y = 0$: $m = 2, 3$ gives $c_1e^{2x} + c_2e^{3x}$."
      },
      {
        "prdId": "M10-PRD06",
        "heading": "PI Shortcuts: $D \\to k$ and $D^2 \\to -\\omega^2$",
        "proseLatex": "$y_{\\text{PI}} = \\frac{1}{f(D)}R(x)$: for $e^{kx}$ replace $D \\to k$ (if $f(k) = 0$, multiply by $x$ and use $f'(D)$); for $\\sin\\omega x$ or $\\cos\\omega x$ replace $D^2 \\to -\\omega^2$ — never $D \\to -\\omega$ (trap). Micro-check: $(D^2 + 4)y = \\cos 3x$: $\\frac{\\cos 3x}{-9 + 4} = -\\frac{\\cos 3x}{5}$."
      }
    ],
    "keyFormulas": [
      {
        "sfId": "M10-SF01",
        "label": "Degree rule",
        "latex": "\\text{degree after clearing radicals/fractions in } y'",
        "use": "Undefined inside $\\sin$, $e$, $\\ln$ of $y'$."
      },
      {
        "sfId": "M10-SF02",
        "label": "Integrating factor",
        "latex": "\\text{IF} = e^{\\int P(x)\\,dx}",
        "use": "After normalizing by the $y'$ coefficient."
      },
      {
        "sfId": "M10-SF03",
        "label": "Linear ODE solution",
        "latex": "y\\cdot\\text{IF} = \\int Q\\cdot\\text{IF}\\,dx + C",
        "use": "First-order linear."
      },
      {
        "sfId": "M10-SF04",
        "label": "Exactness test",
        "latex": "\\frac{\\partial M}{\\partial y} = \\frac{\\partial N}{\\partial x}",
        "use": "$M\\,dx + N\\,dy = 0$."
      },
      {
        "sfId": "M10-SF05",
        "label": "Homogeneous substitution",
        "latex": "y = vx \\Rightarrow v + x\\frac{dv}{dx} = \\phi(v)",
        "use": "Separable reduction."
      },
      {
        "sfId": "M10-SF06",
        "label": "Bernoulli substitution",
        "latex": "u = y^{1-n}:\\ \\frac{du}{dx} + (1-n)Pu = (1-n)Q",
        "use": "Linearizes Bernoulli."
      },
      {
        "sfId": "M10-SF07",
        "label": "Auxiliary equation",
        "latex": "am^2 + bm + c = 0",
        "use": "Roots decide the CF."
      },
      {
        "sfId": "M10-SF08",
        "label": "CF: distinct real roots",
        "latex": "c_1 e^{m_1 x} + c_2 e^{m_2 x}",
        "use": "Two exponentials."
      },
      {
        "sfId": "M10-SF09",
        "label": "CF: repeated root",
        "latex": "(c_1 + c_2 x)e^{mx}",
        "use": "Polynomial $\\times$ exponential."
      },
      {
        "sfId": "M10-SF10",
        "label": "CF: complex roots",
        "latex": "e^{\\alpha x}(c_1\\cos\\beta x + c_2\\sin\\beta x)",
        "use": "Damped oscillation."
      },
      {
        "sfId": "M10-SF11",
        "label": "PI for $e^{kx}$",
        "latex": "\\frac{1}{f(k)}e^{kx}",
        "use": "$f(k) = 0$: multiply by $x$, use $f'(D)$."
      },
      {
        "sfId": "M10-SF12",
        "label": "PI for $\\sin\\omega x$, $\\cos\\omega x$",
        "latex": "D^2 \\to -\\omega^2",
        "use": "Only $D^2$; never $D = -\\omega$."
      },
      {
        "sfId": "M10-SF13",
        "label": "Degree example",
        "latex": "(1+(y')^2)^3 = (y'')^2: \\text{ order } 2, \\text{ degree } 2",
        "use": "Sixth power clears both radicals."
      }
    ],
    "keyDefinitions": [
      {
        "defId": "M10-DEF01",
        "term": "Order",
        "definition": "Highest derivative present in the ODE."
      },
      {
        "defId": "M10-DEF02",
        "term": "Degree",
        "definition": "Positive-integer power of the highest derivative after clearing radicals/fractions; undefined if derivatives sit inside transcendental functions."
      },
      {
        "defId": "M10-DEF03",
        "term": "Integrating factor",
        "definition": "$e^{\\int P\\,dx}$; converts a linear ODE into an exact product derivative."
      },
      {
        "defId": "M10-DEF04",
        "term": "Exact equation",
        "definition": "$M\\,dx + N\\,dy = 0$ with $M_y = N_x$: arises from some $F(x, y) = C$."
      },
      {
        "defId": "M10-DEF05",
        "term": "Homogeneous first-order ODE",
        "definition": "$\\frac{dy}{dx} = \\phi(y/x)$; reduce with $y = vx$."
      },
      {
        "defId": "M10-DEF06",
        "term": "Bernoulli equation",
        "definition": "$y' + Py = Qy^n$; linearized by $u = y^{1-n}$."
      },
      {
        "defId": "M10-DEF07",
        "term": "Complementary function",
        "definition": "General solution of the homogeneous second-order ODE."
      },
      {
        "defId": "M10-DEF08",
        "term": "Particular integral",
        "definition": "Any one solution of the inhomogeneous ODE, found via $1/f(D)$ shortcuts."
      }
    ],
