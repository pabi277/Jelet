    "mcqSelfTest": [
      {
        "mcqId": "P02-MCQ01",
        "stemLatex": "A body starts from rest with $a = 2\\,\\text{m/s}^2$. Its displacement during the $3$rd second is:",
        "options": [
          {
            "id": "A",
            "latex": "$5\\,\\text{m}$"
          },
          {
            "id": "B",
            "latex": "$9\\,\\text{m}$"
          },
          {
            "id": "C",
            "latex": "$4\\,\\text{m}$"
          },
          {
            "id": "D",
            "latex": "$6\\,\\text{m}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$s_3 = \\frac{a}{2}(2n-1) = 1\\times5 = 5\\,\\text{m}$ (check: $9 - 4 = 5$)."
      },
      {
        "mcqId": "P02-MCQ02",
        "stemLatex": "A projectile lands at the launch level with $u = 20\\,\\text{m/s}$, $\\theta = 30°$, $g = 10$. Its range is:",
        "options": [
          {
            "id": "A",
            "latex": "$20\\sqrt{3}\\,\\text{m}$"
          },
          {
            "id": "B",
            "latex": "$10\\sqrt{3}\\,\\text{m}$"
          },
          {
            "id": "C",
            "latex": "$40\\,\\text{m}$"
          },
          {
            "id": "D",
            "latex": "$20\\,\\text{m}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$R = \\frac{400\\sin 60°}{10} = 20\\sqrt{3}\\,\\text{m}$."
      },
      {
        "mcqId": "P02-MCQ03",
        "stemLatex": "At the highest point of a projectile's path:",
        "options": [
          {
            "id": "A",
            "latex": "velocity and acceleration are both zero"
          },
          {
            "id": "B",
            "latex": "velocity is horizontal, acceleration is $g$ downward"
          },
          {
            "id": "C",
            "latex": "velocity is zero, acceleration is $g$"
          },
          {
            "id": "D",
            "latex": "velocity and acceleration are parallel"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "$v_y = 0$ but $v_x = u\\cos\\theta$; $\\vec{a} = -g\\hat{j}$ throughout."
      },
      {
        "mcqId": "P02-MCQ04",
        "stemLatex": "Two projectiles are launched at $30°$ and $60°$ with the same speed. The ratio of maximum heights $H_{30}/H_{60}$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$\\frac{1}{3}$"
          },
          {
            "id": "B",
            "latex": "$\\frac{1}{2}$"
          },
          {
            "id": "C",
            "latex": "$1$"
          },
          {
            "id": "D",
            "latex": "$3$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$H \\propto \\sin^2\\theta$: ratio $= \\frac{(1/2)^2}{(\\sqrt{3}/2)^2} = \\frac{1}{3}$ ($= \\tan^2 30°$)."
      },
      {
        "mcqId": "P02-MCQ05",
        "stemLatex": "A boat heads straight across a $3\\,\\text{m/s}$ stream at $5\\,\\text{m/s}$. Its ground speed is:",
        "options": [
          {
            "id": "A",
            "latex": "$8\\,\\text{m/s}$"
          },
          {
            "id": "B",
            "latex": "$\\sqrt{34}\\,\\text{m/s}$"
          },
          {
            "id": "C",
            "latex": "$2\\,\\text{m/s}$"
          },
          {
            "id": "D",
            "latex": "$5.8\\,\\text{m/s}$"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "Perpendicular addition: $\\sqrt{25 + 9} = \\sqrt{34}$."
      },
      {
        "mcqId": "P02-MCQ06",
        "stemLatex": "For uniform circular motion with $v = 4\\,\\text{m/s}$, $r = 2\\,\\text{m}$: the acceleration magnitude is:",
        "options": [
          {
            "id": "A",
            "latex": "$8\\,\\text{m/s}^2$ inward"
          },
          {
            "id": "B",
            "latex": "$8\\,\\text{m/s}^2$ outward"
          },
          {
            "id": "C",
            "latex": "$2\\,\\text{m/s}^2$ inward"
          },
          {
            "id": "D",
            "latex": "$0$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$a_c = v^2/r = 8\\,\\text{m/s}^2$, radially inward even though speed is constant."
      },
      {
        "mcqId": "P02-MCQ07",
        "stemLatex": "A body moves with $v$-$t$ graph: $+4\\,\\text{m/s}$ for $2\\,\\text{s}$, then $-4\\,\\text{m/s}$ for $2\\,\\text{s}$. Displacement and distance are:",
        "options": [
          {
            "id": "A",
            "latex": "$0$ and $16\\,\\text{m}$"
          },
          {
            "id": "B",
            "latex": "$16\\,\\text{m}$ and $16\\,\\text{m}$"
          },
          {
            "id": "C",
            "latex": "$0$ and $8\\,\\text{m}$"
          },
          {
            "id": "D",
            "latex": "$-16\\,\\text{m}$ and $16\\,\\text{m}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "Signed areas cancel ($0$); unsigned areas add ($8 + 8 = 16\\,\\text{m}$)."
      },
      {
        "mcqId": "P02-MCQ08",
        "stemLatex": "A body moves along a STRAIGHT line with speed $v$ and tangential acceleration $a$. Then $\\frac{dv}{dx}$ equals $\\frac{a}{v}$ because:",
        "options": [
          {
            "id": "A",
            "latex": "$a = \\frac{dv}{dt}$ and $v = \\frac{dx}{dt}$"
          },
          {
            "id": "B",
            "latex": "$a$ is constant"
          },
          {
            "id": "C",
            "latex": "$v$ is constant"
          },
          {
            "id": "D",
            "latex": "of Newton's third law"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "Chain rule in 1D: $\\frac{dv}{dt} = \\frac{dv}{dx}\\frac{dx}{dt} = \\frac{dv}{dx}\\,v$, so $\\frac{dv}{dx} = \\frac{a}{v}$."
      },
      {
        "mcqId": "P02-MCQ09",
        "stemLatex": "The range of a projectile is maximum at launch angle:",
        "options": [
          {
            "id": "A",
            "latex": "$30°$"
          },
          {
            "id": "B",
            "latex": "$45°$"
          },
          {
            "id": "C",
            "latex": "$60°$"
          },
          {
            "id": "D",
            "latex": "$90°$"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "$\\sin 2\\theta$ peaks at $2\\theta = 90°$: $R_{\\max} = u^2/g$."
      },
      {
        "mcqId": "P02-MCQ10",
        "stemLatex": "In non-uniform circular motion with $a_c = 8$ and $a_t = 6$ (orthogonal), the net acceleration is:",
        "options": [
          {
            "id": "A",
            "latex": "$10\\,\\text{m/s}^2$"
          },
          {
            "id": "B",
            "latex": "$14\\,\\text{m/s}^2$"
          },
          {
            "id": "C",
            "latex": "$2\\,\\text{m/s}^2$"
          },
          {
            "id": "D",
            "latex": "$48\\,\\text{m/s}^2$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$\\sqrt{64 + 36} = 10$ — orthogonal components add in quadrature."
      }
    ],
    "memoryHooks": [
      "Slope of $x$-$t$ is $v$; slope of $v$-$t$ is $a$.",
      "Signed area = displacement; |area| = distance.",
      "$s_n = u + \\frac{a}{2}(2n-1)$ — odd numbers $1, 3, 5\\dots$",
      "$R$ peaks at $45°$; complementary angles share $R$.",
      "$H_1/H_2 = \\tan^2\\theta$ for complementary launches.",
      "Apex: $v_y = 0$, $v_x$ alive, $a = g$ down.",
      "$\\vec{v}_{AB} = \\vec{v}_A - \\vec{v}_B$.",
      "$a_c = v^2/r$ always inward; $a_{\\text{net}} = \\sqrt{a_c^2 + a_t^2}$.",
      "$v\\frac{dv}{dx}$ for acceleration as a function of position."
    ],
    "commonMistakes": [
      "Reporting signed area as total distance.",
      "Claiming velocity is zero at the projectile apex.",
      "Applying SUVAT to non-uniform acceleration.",
      "Forgetting $\\tan^2\\theta$ (not $\\tan\\theta$) in height ratios.",
      "Adding relative velocities as scalars.",
      "Drawing $a_c$ outward.",
      "Using $s_n$ formula with $n$ instead of $(2n-1)$.",
      "Rushing the final unit conversion after a correct setup."
    ],
    "examChecklist": [
      "Convert graphs to slopes/areas with signs accounted.",
      "Pick SUVAT only for constant $a$.",
      "Use $s_n$ for nth-second questions.",
      "Projectile: quote $R$, $H$, $T$ and the complementary-angle pair.",
      "State apex conditions ($v_y = 0$).",
      "Relative velocity by vector subtraction.",
      "Circular: $a_c$ inward, combine with $a_t$ in quadrature.",
      "Sanity-check the order of magnitude at the end."
    ],
