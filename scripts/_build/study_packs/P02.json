        "label": "Displacement vs distance",
        "latex": "\\Delta x = \\int v\\,dt;\\quad d = \\int|v|\\,dt",
        "use": "Signed vs unsigned area."
      }
    ],
    "keyDefinitions": [
      {
        "defId": "P02-DEF01",
        "term": "Displacement",
        "definition": "Signed change of position; area under $v$-$t$ with signs."
      },
      {
        "defId": "P02-DEF02",
        "term": "Total distance",
        "definition": "Path length; unsigned area under $v$-$t$."
      },
      {
        "defId": "P02-DEF03",
        "term": "Projectile",
        "definition": "Body under gravity alone after launch: constant $v_x$, free-fall $v_y$."
      },
      {
        "defId": "P02-DEF04",
        "term": "Complementary projectiles",
        "definition": "Launch angles summing to $90°$; equal range, different heights."
      },
      {
        "defId": "P02-DEF05",
        "term": "Relative velocity",
        "definition": "Velocity of one body measured in the other's frame."
      },
      {
        "defId": "P02-DEF06",
        "term": "Centripetal acceleration",
        "definition": "Inward acceleration $v^2/r$ required for curved motion."
      },
      {
        "defId": "P02-DEF07",
        "term": "Tangential acceleration",
        "definition": "$dv/dt$ along the path; changes speed, not direction."
      }
    ],
