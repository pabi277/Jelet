  "unitId": "P09",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "P09-PRD01",
        "heading": "Linear, Superficial & Volume Expansion",
        "proseLatex": "Heating an isotropic solid by $\\Delta T$: $L = L_0(1+\\alpha\\Delta T)$, $A = A_0(1+\\beta\\Delta T)$, $V = V_0(1+\\gamma\\Delta T)$ with the exact ratio $\\alpha : \\beta : \\gamma = 1 : 2 : 3$ for small $\\alpha\\Delta T \\ll 1$ ($\\beta = 2\\alpha$, $\\gamma = 3\\alpha$). Cavities and holes expand too. Micro-check: $\\alpha = 2\\times10^{-5}$, $\\Delta T = 500$: $\\frac{\\Delta L}{L} = 1\\%$, $\\frac{\\Delta V}{V} = 3\\%$."
      },
      {
        "prdId": "P09-PRD02",
        "heading": "Density Drops as Temperature Rises",
        "proseLatex": "$\\rho_T = \\frac{\\rho_0}{1+\\gamma\\Delta T} \\approx \\rho_0(1 - \\gamma\\Delta T)$ for small $\\gamma\\Delta T$. Micro-check: $\\gamma = 3\\times10^{-5}$, $\\Delta T = 100$: density falls $0.3\\%$."
      },
      {
        "prdId": "P09-PRD03",
        "heading": "Bimetallic Strips & the Equal-Difference Rod Pair",
        "proseLatex": "A welded strip of two metals ($\\alpha_1 > \\alpha_2$) bends on heating with the HIGHER-$\\alpha$ metal on the OUTER (convex) side, and flips on cooling. Two rods keep a temperature-independent length difference iff $L_1\\alpha_1 = L_2\\alpha_2$. Micro-check: $L_1 = 2L_2$ requires $\\alpha_2 = 2\\alpha_1$… i.e. the shorter rod carries the larger $\\alpha$."
      },
      {
        "prdId": "P09-PRD04",
        "heading": "Pendulum Clock Drift",
        "proseLatex": "$T = 2\\pi\\sqrt{L/g}$: heating lengthens $L$, so $T$ grows and the clock runs SLOW, losing $\\frac{\\Delta t}{t} = \\frac{1}{2}\\alpha\\Delta T$ seconds per second (the $\\frac{1}{2}$ from $\\sqrt{L}$). Micro-check: $\\alpha = 2\\times10^{-5}$, $\\Delta T = 20$: loses $2\\times10^{-4}\\,\\text{s/s} = 17.3\\,\\text{s/day}$ ($\\times 86400$)."
      },
      {
        "prdId": "P09-PRD05",
        "heading": "Real vs Apparent Liquid Expansion",
        "proseLatex": "The container expands too ($\\gamma_g = 3\\alpha_g$), so observed apparent expansion is smaller: $\\gamma_{\\text{real}} = \\gamma_{\\text{app}} + \\gamma_{\\text{glass}}$. Micro-check: $\\gamma_{\\text{app}} = 1.8\\times10^{-4}$, $\\gamma_g = 2.7\\times10^{-5}$: $\\gamma_{\\text{real}} \\approx 2.07\\times10^{-4}$."
      },
      {
        "prdId": "P09-PRD06",
        "heading": "Water's Anomaly at $4\\,^\\circ\\text{C}$",
        "proseLatex": "From $0$ to $4\\,^\\circ\\text{C}$ water CONTRACTS on heating, reaching maximum density ($1000\\,\\text{kg/m}^3$) and minimum volume at $4\\,^\\circ\\text{C}$. A brim-full vessel overflows whether you warm it above $4\\,^\\circ\\text{C}$ OR cool it below — both directions increase volume. Ice floats; lakes stay liquid under surface ice, saving aquatic life. Micro-check: at $4\\,^\\circ\\text{C}$ the brim vessel is at its SAFEST (minimum volume)."
      }
    ],
    "keyFormulas": [
      {
        "sfId": "P09-SF01",
        "label": "Linear expansion",
        "latex": "L = L_0(1+\\alpha\\Delta T)",
        "use": "All linear dimensions, holes included."
      },
      {
        "sfId": "P09-SF02",
        "label": "Superficial expansion",
        "latex": "A = A_0(1+\\beta\\Delta T)",
        "use": "\\beta = 2\\alpha$."
      },
      {
        "sfId": "P09-SF03",
        "label": "Volume expansion",
        "latex": "V = V_0(1+\\gamma\\Delta T)",
        "use": "\\gamma = 3\\alpha$."
      },
      {
        "sfId": "P09-SF04",
        "label": "Expansion ratio",
        "latex": "\\alpha : \\beta : \\gamma = 1 : 2 : 3",
        "use": "Isotropic solids, small $\\Delta T$."
      },
      {
        "sfId": "P09-SF05",
        "label": "Density shift",
        "latex": "\\rho_T = \\frac{\\rho_0}{1+\\gamma\\Delta T}",
        "use": "Density falls on heating."
      },
      {
        "sfId": "P09-SF06",
        "label": "Equal-difference rods",
        "latex": "L_1\\alpha_1 = L_2\\alpha_2",
        "use": "Temperature-independent gap."
      },
      {
        "sfId": "P09-SF07",
        "label": "Pendulum drift",
        "latex": "\\frac{\\Delta t}{t} = \\frac{1}{2}\\alpha\\Delta T",
        "use": "Clock loses time when heated."
      },
      {
        "sfId": "P09-SF08",
        "label": "Day loss",
        "latex": "\\Delta t_{\\text{day}} = \\frac{1}{2}\\alpha\\Delta T\\times86400",
        "use": "Seconds lost per day."
      },
      {
        "sfId": "P09-SF09",
        "label": "Real vs apparent",
        "latex": "\\gamma_{\\text{real}} = \\gamma_{\\text{app}} + \\gamma_{\\text{vessel}}",
        "use": "Vessel expands too."
      },
      {
        "sfId": "P09-SF10",
        "label": "Bimetallic bend",
        "latex": "\\alpha_{\\text{high}}\\text{ on the convex side}",
        "use": "Flips when cooled."
      },
      {
        "sfId": "P09-SF11",
        "label": "Hole diameter growth",
        "latex": "d = d_0(1+\\alpha\\Delta T)",
        "use": "Photographic enlargement — never shrinks."
      },
      {
        "sfId": "P09-SF12",
        "label": "Second-order check",
        "latex": "(1+\\gamma\\Delta T)^{1/3} \\approx 1+\\alpha\\Delta T",
        "use": "Why the $1{:}2{:}3$ ratio holds."
      },
      {
        "sfId": "P09-SF13",
        "label": "Clock period shift",
        "latex": "\\frac{\\Delta T_{\\text{period}}}{T} = \\frac{1}{2}\\frac{\\Delta L}{L} = \\frac{1}{2}\\alpha\\Delta T",
        "use": "From $T \\propto \\sqrt{L}$."
      }
    ],
