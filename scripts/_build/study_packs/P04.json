{
  "unitId": "P04",
  "studyPack": {
    "conceptPrimer": [
      {
        "prdId": "P04-PRD01",
        "heading": "Work by Variable Forces & the Zero-Work Cases",
        "proseLatex": "$W = \\int\\vec{F}\\cdot d\\vec{r}$ (constant force: $FD\\cos\\theta$). Centripetal force does ZERO work ($\\vec{F}\\perp d\\vec{r}$ always). Micro-check: $F = 10\\,\\text{N}$ at $60°$ over $5\\,\\text{m}$: $W = 25\\,\\text{J}$."
      },
      {
        "prdId": "P04-PRD02",
        "heading": "Work-Energy Theorem & the $K$-$p$ Link",
        "proseLatex": "$W_{\\text{all}} = \\Delta K$ holds universally, friction included. $K = \\frac{p^2}{2m}$: equal momenta $\\Rightarrow$ the LIGHTER body carries more $K$ ($K \\propto 1/m$); equal speeds $\\Rightarrow$ $K \\propto m$. Micro-check: $m$ vs $2m$ at equal $p$: $K$ ratio $2 : 1$."
      },
      {
        "prdId": "P04-PRD03",
        "heading": "Conservative Forces & Spring Energy",
        "proseLatex": "Conservative $\\oint\\vec{F}\\cdot d\\vec{r} = 0$, $\\vec{F} = -\\nabla U$: gravity $U = mgh$, spring $U_s = \\frac{1}{2}kx^2$. With $W_{\\text{nc}} = 0$, $E = K + U$ is conserved. Micro-check: $k = 500$, $x = 0.2$: $U_s = 10\\,\\text{J}$."
      },
      {
        "prdId": "P04-PRD04",
        "heading": "Percent Changes: Exact, Not Linear",
        "proseLatex": "$K = \\frac{p^2}{2m}$: small changes allow $\\frac{\\Delta K}{K} \\approx 2\\frac{\\Delta p}{p}$, but finite ones need $(1+\\delta)^2 - 1$: $+100\\%$ in $p$ gives $4K - K = +300\\%$, NOT $+200\\%$. Micro-check: $\\delta = 0.1$: $21\\%$, slightly more than linear $20\\%$."
      },
      {
        "prdId": "P04-PRD05",
        "heading": "Constant-Power Vehicles",
        "proseLatex": "$P_0 = Fv = mv\\frac{dv}{dt}$ gives $v \\propto t^{1/2}$ and $x \\propto t^{3/2}$, with $a = \\frac{P_0}{mv}$ decreasing as $v$ grows. Micro-check: $m = 1000\\,\\text{kg}$, $P_0 = 50\\,\\text{kW}$, $v = 10$: $a = 5\\,\\text{m/s}^2$."
      },
      {
        "prdId": "P04-PRD06",
        "heading": "Vertical Circle Minimum Speeds & Collision Restitution",
        "proseLatex": "String loop radius $R$: $v_{\\text{top}} = \\sqrt{gR}$, $v_{\\text{bottom}} = \\sqrt{5gR}$; a rigid ROD needs only $v_{\\text{bottom}} = \\sqrt{4gR}$. Restitution $e = \\frac{v_2 - v_1}{u_1 - u_2}$: $e = 1$ elastic (equal masses swap velocities), $0 < e < 1$ inelastic, $e = 0$ coalescence. Momentum is conserved in ALL collisions. Micro-check: $e = 1$, equal masses, $u_1 = 6$, $u_2 = 0$: $v_1 = 0$, $v_2 = 6$."
      }
    ],
    "keyFormulas": [
      {
        "sfId": "P04-SF01",
        "label": "Work (general)",
        "latex": "W = \\int\\vec{F}\\cdot d\\vec{r}",
        "use": "Constant force: $FD\\cos\\theta$."
      },
      {
        "sfId": "P04-SF02",
        "label": "Work-energy theorem",
        "latex": "W_{\\text{all}} = \\Delta K",
        "use": "Universally true, friction included."
      },
      {
        "sfId": "P04-SF03",
        "label": "$K$-$p$ relation",
        "latex": "K = \\frac{p^2}{2m}",
        "use": "Equal $p$: $K \\propto 1/m$."
      },
      {
        "sfId": "P04-SF04",
        "label": "Spring potential",
        "latex": "U_s = \\tfrac{1}{2}kx^2",
        "use": "Hookean spring."
      },
      {
        "sfId": "P04-SF05",
        "label": "Mechanical energy",
        "latex": "E = K + U\\ (W_{\\text{nc}} = 0)",
        "use": "Conserved without friction."
      },
      {
