      },
      {
        "sfId": "P04-SF10",
        "label": "Rod loop speed",
        "latex": "v_{\\text{bottom}} = \\sqrt{4gR}",
        "use": "Rod supports compression."
      },
      {
        "sfId": "P04-SF11",
        "label": "Coefficient of restitution",
        "latex": "e = \\frac{v_2 - v_1}{u_1 - u_2}",
        "use": "$1$ elastic, $0$ sticky."
      },
      {
        "sfId": "P04-SF12",
        "label": "Gravitational PE (uniform)",
        "latex": "U = mgh",
        "use": "Near-surface conservative store."
      }
    ],
    "keyDefinitions": [
      {
        "defId": "P04-DEF01",
        "term": "Work",
        "definition": "Energy transferred by force along displacement: $\\vec{F}\\cdot\\vec{d}$ or the integral."
      },
      {
        "defId": "P04-DEF02",
        "term": "Conservative force",
        "definition": "Closed-loop work zero; defines potential energy."
      },
      {
        "defId": "P04-DEF03",
        "term": "Kinetic energy",
        "definition": "$\\frac{1}{2}mv^2 = \\frac{p^2}{2m}$."
      },
      {
        "defId": "P04-DEF04",
        "term": "Instantaneous power",
        "definition": "$\\vec{F}\\cdot\\vec{v}$ — the rate of doing work."
      },
      {
        "defId": "P04-DEF05",
        "term": "Coefficient of restitution",
        "definition": "Relative-speed ratio measuring collision elasticity."
      },
      {
        "defId": "P04-DEF06",
        "term": "Work-energy theorem",
        "definition": "Total work equals kinetic-energy change, always."
      }
    ],
