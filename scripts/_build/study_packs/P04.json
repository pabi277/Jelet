        "latex": "v \\propto t^{1/2};\\quad x \\propto t^{3/2}",
        "use": "$P_0 = Fv$ engine."
      },
      {
        "sfId": "P04-SF08",
        "label": "Finite percent change",
        "latex": "(1+\\delta)^2 - 1",
        "use": "Exact for $\\ge 5\\%$ changes."
      },
      {
