    "mcqSelfTest": [
      {
        "mcqId": "P04-MCQ01",
        "stemLatex": "A force of $10\\,\\text{N}$ at $60°$ to the horizontal moves a body $5\\,\\text{m}$ horizontally. Work done is:",
        "options": [
          {
            "id": "A",
            "latex": "$25\\,\\text{J}$"
          },
          {
            "id": "B",
            "latex": "$50\\,\\text{J}$"
          },
          {
            "id": "C",
            "latex": "$43\\,\\text{J}$"
          },
          {
            "id": "D",
            "latex": "$0$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$W = FD\\cos\\theta = 10\\times5\\times0.5 = 25\\,\\text{J}$."
      },
      {
        "mcqId": "P04-MCQ02",
        "stemLatex": "Two bodies of masses $m$ and $2m$ have equal momentum. Their KE ratio is:",
        "options": [
          {
            "id": "A",
            "latex": "$2 : 1$"
          },
          {
            "id": "B",
            "latex": "$1 : 2$"
          },
          {
            "id": "C",
            "latex": "$1 : 1$"
          },
          {
            "id": "D",
            "latex": "$4 : 1$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$K = p^2/2m$: the lighter body has double the KE."
      },
      {
        "mcqId": "P04-MCQ03",
        "stemLatex": "Momentum of a body increases by $100\\%$. Its KE increases by:",
        "options": [
          {
            "id": "A",
            "latex": "$100\\%$"
          },
          {
            "id": "B",
            "latex": "$200\\%$"
          },
          {
            "id": "C",
            "latex": "$300\\%$"
          },
          {
            "id": "D",
            "latex": "$50\\%$"
          }
        ],
        "correct": [
          "C"
        ],
        "explanation": "$(1+1)^2 - 1 = 3$: $+300\\%$ — the linear $2\\delta$ rule fails at $100\\%$."
      },
      {
        "mcqId": "P04-MCQ04",
        "stemLatex": "A spring with $k = 500\\,\\text{N/m}$ is compressed $0.2\\,\\text{m}$. Stored energy is:",
        "options": [
          {
            "id": "A",
            "latex": "$10\\,\\text{J}$"
          },
          {
            "id": "B",
            "latex": "$20\\,\\text{J}$"
          },
          {
            "id": "C",
            "latex": "$5\\,\\text{J}$"
          },
          {
            "id": "D",
            "latex": "$100\\,\\text{J}$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$\\frac{1}{2}\\times500\\times0.04 = 10\\,\\text{J}$."
      },
      {
        "mcqId": "P04-MCQ05",
        "stemLatex": "A $1000\\,\\text{kg}$ car with a $50\\,\\text{kW}$ engine moves at $10\\,\\text{m/s}$. Its acceleration is:",
        "options": [
          {
            "id": "A",
            "latex": "$5\\,\\text{m/s}^2$"
          },
          {
            "id": "B",
            "latex": "$0.5\\,\\text{m/s}^2$"
          },
          {
            "id": "C",
            "latex": "$50\\,\\text{m/s}^2$"
          },
          {
            "id": "D",
            "latex": "$10\\,\\text{m/s}^2$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$a = \\frac{P}{mv} = \\frac{50000}{10000} = 5\\,\\text{m/s}^2$."
      },
      {
        "mcqId": "P04-MCQ06",
        "stemLatex": "The minimum bottom speed to complete a string vertical loop of radius $R$ is:",
        "options": [
          {
            "id": "A",
            "latex": "$\\sqrt{gR}$"
          },
          {
            "id": "B",
            "latex": "$\\sqrt{2gR}$"
          },
          {
            "id": "C",
            "latex": "$\\sqrt{4gR}$"
          },
          {
            "id": "D",
            "latex": "$\\sqrt{5gR}$"
          }
        ],
        "correct": [
          "D"
        ],
        "explanation": "Energy: $\\frac{1}{2}mv_b^2 = \\frac{1}{2}m(gR) + mg(2R) \\Rightarrow v_b = \\sqrt{5gR}$."
      },
      {
        "mcqId": "P04-MCQ07",
        "stemLatex": "For a rigid ROD vertical circle, the minimum bottom speed is:",
        "options": [
          {
            "id": "A",
            "latex": "$\\sqrt{gR}$"
          },
          {
            "id": "B",
            "latex": "$\\sqrt{2gR}$"
          },
          {
            "id": "C",
            "latex": "$\\sqrt{4gR}$"
          },
          {
            "id": "D",
            "latex": "$\\sqrt{5gR}$"
          }
        ],
        "correct": [
          "C"
        ],
        "explanation": "The rod supports compression: top speed may be $0$, so $v_b = \\sqrt{4gR}$."
      },
      {
        "mcqId": "P04-MCQ08",
        "stemLatex": "In an elastic 1D collision between equal masses ($u_2 = 0$), the velocities after are:",
        "options": [
          {
            "id": "A",
            "latex": "$v_1 = 0$, $v_2 = u_1$"
          },
          {
            "id": "B",
            "latex": "$v_1 = u_1$, $v_2 = 0$"
          },
          {
            "id": "C",
            "latex": "$v_1 = v_2 = u_1/2$"
          },
          {
            "id": "D",
            "latex": "$v_1 = -u_1$"
          }
        ],
        "correct": [
          "A"
        ],
        "explanation": "$e = 1$ with equal masses simply swaps velocities."
      },
      {
        "mcqId": "P04-MCQ09",
        "stemLatex": "Which is conserved in EVERY isolated collision?",
        "options": [
          {
            "id": "A",
            "latex": "kinetic energy"
          },
          {
            "id": "B",
            "latex": "linear momentum"
          },
          {
            "id": "C",
            "latex": "both always"
          },
          {
            "id": "D",
            "latex": "neither"
          }
        ],
        "correct": [
          "B"
        ],
        "explanation": "Momentum always; KE only when $e = 1$."
      },
      {
        "mcqId": "P04-MCQ10",
        "stemLatex": "The work done by centripetal force over one full circular lap is:",
        "options": [
          {
            "id": "A",
            "latex": "$mv^2$"
          },
          {
            "id": "B",
            "latex": "$2\\pi mv^2$"
          },
          {
            "id": "C",
            "latex": "$0$"
          },
          {
            "id": "D",
            "latex": "$\\frac{1}{2}mv^2$"
          }
        ],
        "correct": [
          "C"
        ],
        "explanation": "$\\vec{F}\\perp d\\vec{r}$ at every instant: zero work."
      }
    ],
    "memoryHooks": [
      "$W = \\vec{F}\\cdot\\vec{d}$: the $\\cos\\theta$ matters.",
      "Centripetal force does zero work.",
      "$K = p^2/2m$: equal $p$ $\\to$ lighter wins KE.",
      "$+100\\%$ in $p$ = $+300\\%$ in $K$ (exact, not $2\\delta$).",
      "$U_s = \\frac{1}{2}kx^2$; $E = K + U$ without friction.",
      "$P = \\vec{F}\\cdot\\vec{v}$; constant $P$: $v \\propto \\sqrt{t}$.",
      "String loop: $\\sqrt{gR}$ top, $\\sqrt{5gR}$ bottom.",
      "Rod loop: only $\\sqrt{4gR}$ bottom.",
      "$e = 1$ equal masses swap; $e = 0$ stick.",
      "Momentum always conserved; KE only if elastic."
    ],
    "commonMistakes": [
      "Using linear $2\\delta$ for percent changes beyond $\\sim 5\\%$.",
      "Dropping the $\\frac{1}{2}$ in spring or stored-work energy.",
      "Quoting $\\sqrt{5gR}$ for a rod loop.",
      "Claiming KE is conserved in inelastic collisions.",
      "Writing $P = Fv$ without the angle in the dot product.",
      "Forgetting $W_{\\text{nc}}$ terms in the work-energy theorem.",
      "Mixing up string and rod loop speeds.",
      "Rushing the final unit conversion after a correct setup."
    ],
    "examChecklist": [
      "Integrate $\\vec{F}\\cdot d\\vec{r}$ for variable forces.",
      "Apply $W_{\\text{all}} = \\Delta K$ including friction paths.",
      "Switch between $K = \\frac{p^2}{2m}$ and $\\frac{1}{2}mv^2$ as needed.",
      "Use exact $(1+\\delta)^2 - 1$ for finite percent changes.",
      "Constant power: $a = P_0/mv$, $v \\propto t^{1/2}$.",
      "Vertical-circle minimum speeds: string vs rod.",
      "Collision toolkit: momentum + restitution equations.",
      "Identify zero-work cases ($\\vec{F}\\perp d\\vec{r}$)."
    ],
